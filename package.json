{
  "name": "hydroponic-test-simulation",
  "version": "1.0.0",
  "description": "Test simulation system for hydroponic integration within Gladys home automation",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "hydroponic-sim": "dist/main.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
